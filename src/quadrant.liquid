<div class="layout layout--col">
  <div class="columns" data-overflow-cols="1" data-overflow-counter="true">
    <div class="column">
      {% for c in contests %}
        {% if c.end_ts > now %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="title title--small" data-clamp="1">
                {% if c.start_ts <= now %}&#9679; {% endif %}{{ c.title }}
              </span>
              <span class="label label--small label--underline">{{ c.when }}</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23000' stroke-width='2' stroke-linecap='round'%3E%3Crect x='3' y='5' width='18' height='16' rx='2'/%3E%3Cpath d='M3 10h18M8 3v4M16 3v4'/%3E%3C/svg%3E">
  <span class="title">WA7BNM Contest Calendar</span>
</div>