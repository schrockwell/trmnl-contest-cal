<div class="layout">
  <div class="columns" data-overflow-cols="3" data-overflow-cols-lg="4" data-overflow-counter="true">
    <div class="column">
      {% for c in contests %}
        {% if c.end_ts > now %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="title title--small" data-clamp="1">{{ c.title }}</span>
              <div class="flex flex--row gap--xsmall">
                {% if c.start_ts <= now %}
                  <span class="label label--small label--filled">ACTIVE</span>
                {% endif %}
                <span class="label label--small label--underline">{{ c.when }}</span>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23000' stroke-width='2' stroke-linecap='round'%3E%3Crect x='3' y='5' width='18' height='16' rx='2'/%3E%3Cpath d='M3 10h18M8 3v4M16 3v4'/%3E%3C/svg%3E">
  <span class="title">WA7BNM Contest Calendar</span>
  <span class="instance">{% if live_count > 0 %}{{ live_count }} active &bull; {% endif %}{{ next_count }} upcoming</span>
</div>